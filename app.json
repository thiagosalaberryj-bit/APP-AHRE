{
  "expo": {
    "name": "AHRE",
    "slug": "APP-AHRE",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ahre-mark.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/ahre-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F4F4"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#024C42",
        "foregroundImage": "./assets/ahre-mark.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ]
    ]
  }
}
