{
  "expo": {
    "name": "AHRE",
    "slug": "APP-AHRE",
    "version": "0.9.1",
    "orientation": "portrait",
    "icon": "./assets/ahre-mark.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "versionCode": 15,
      "adaptiveIcon": {
        "backgroundColor": "#024C42",
        "foregroundImage": "./assets/ahre-mark.png"
      },
      "package": "com.thiagosalaberry.APPAHRE",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Permití a AHRE acceder a la cámara para fotografiar comprobantes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/ahre-logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F4F4F4",
          "dark": {
            "image": "./assets/ahre-logo.png",
            "backgroundColor": "#081C19"
          }
        }
      ],
      "./plugins/withCompleteAdaptiveIcon",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ],
    "extra": {
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "bb770d78-0970-4c53-9bad-31c73a5c86fd"
      }
    },
    "scheme": "ahre"
  }
}
